# =============================================================================
# Plantilla de variables de entorno — copiar a .env.local y completar.
# NUNCA versionar valores reales. Detalle por ambiente: docs/setup/env.md
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=local                       # local | development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Sesión ------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Generar con:  openssl rand -base64 48
SESSION_SECRET=

# --- AWS Cognito (pool DEV en cuenta personal: docs/setup/cognito-dev.md) -----
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=              # solo servidor
COGNITO_DOMAIN=                     # <prefijo>.auth.us-east-2.amazoncognito.com
COGNITO_SCOPES=openid email profile  # el pool del GAD no soporta `phone`
COGNITO_IDENTITY_PROVIDERS=         # p. ej. Google (Facebook: pendiente de aprobación de Meta)
COGNITO_EXTRA_CLIENT_IDS=           # client IDs adicionales aceptados como Bearer (app móvil)

# --- Supabase (local: valores que imprime `supabase start`) -------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                # solo servidor (rol service_role)
