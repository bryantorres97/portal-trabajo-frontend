# =============================================================================
# Plantilla de variables de entorno — copiar a .env.local y completar.
# NUNCA versionar valores reales. Detalle por ambiente: docs/setup/env.md
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=local                       # local | development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Sesión ------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Generar con:  openssl rand -base64 48
SESSION_SECRET=

# --- AWS Cognito (pool DEV en cuenta personal: docs/setup/cognito-dev.md) -----
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=              # solo servidor
COGNITO_DOMAIN=                     # <prefijo>.auth.us-east-2.amazoncognito.com
COGNITO_SCOPES=openid email profile  # el pool del GAD no soporta `phone`
COGNITO_IDENTITY_PROVIDERS=         # p. ej. Google (Facebook: pendiente de aprobación de Meta)
COGNITO_EXTRA_CLIENT_IDS=           # client IDs adicionales aceptados como Bearer (app móvil)

# --- Microsoft Entra ID: ingreso del personal del GAD (docs/setup/entra-dev.md) --
ENTRA_TENANT_ID=                    # GUID del tenant
ENTRA_CLIENT_ID=                    # Application (client) ID
ENTRA_CLIENT_SECRET=                # solo servidor: el "Value" del secreto
ENTRA_BOOTSTRAP_ADMIN_OIDS=         # opcional: oid(s) que reciben ADMIN_SISTEMA si aún no hay administradores

# --- Supabase (local: valores que imprime `supabase start`) -------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                # solo servidor (rol service_role)

# --- Realtime del chat (ADR-004, docs/setup/realtime.md) ------------------------
# JWK privado ES256 en una línea. Local: el objeto de supabase/signing_keys.json (pnpm db:keys).
REALTIME_JWT_PRIVATE_KEY=

# --- Push con Firebase Cloud Messaging (opcional; sin estas variables no hay push) --
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=                    # PEM de la cuenta de servicio (los saltos de línea como)
# Push en el navegador: app web de Firebase (valores públicos; docs/setup/firebase-dev.md)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=     # opcional: clave pública de «Certificados de push web»

# --- Tareas programadas ---------------------------------------------------------
CRON_SECRET=                        # mínimo 32 caracteres; lo envía Vercel Cron como Bearer
