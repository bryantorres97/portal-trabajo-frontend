# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Recursos
resources/

# Plantilla de variables (sí se versiona)
!.env.example

# Playwright
/test-results/
/playwright-report/

# Clave privada ES256 local para firmar JWT (Realtime, ADR-004). Se genera con: supabase gen signing-key
supabase/signing_keys.json
